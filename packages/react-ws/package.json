{
  "name": "react-ws-context",
  "version": "0.3.0",
  "description": "React WebSocket connection layer — separate hooks for actions, connection state, and message events to avoid unnecessary re-renders",
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "websocket",
    "ws",
    "context",
    "client"
  ],
  "license": "MIT",
  "author": "GaiaYang (https://github.com/GaiaYang)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaiaYang/react-ws.git",
    "directory": "packages/react-ws"
  },
  "homepage": "https://github.com/GaiaYang/react-ws/tree/main/packages/react-ws#readme",
  "bugs": {
    "url": "https://github.com/GaiaYang/react-ws/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./stall": {
      "types": "./dist/stall/index.d.mts",
      "import": "./dist/stall/index.mjs",
      "default": "./dist/stall/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  }
}
